{
  "name": "@cascade/monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Cascade — Dependency intelligence and change-impact analysis platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix packages/dashboard",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint packages/*/src/**/*.ts --no-error-on-unmatched-pattern",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "npm run clean --workspaces",
    "check": "npm run lint && npm run build && npm run typecheck && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdulGani07/cascade.git"
  },
  "keywords": [
    "dependency-analysis",
    "change-impact",
    "static-analysis",
    "code-intelligence",
    "ast",
    "architecture-governance"
  ],
  "author": "Cascade Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "dagre": "^0.8.5",
    "lucide-react": "^1.27.0",
    "minimatch": "^10.2.5",
    "tailwindcss": "^4.3.3",
    "tree-sitter": "^0.22.2",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  }
}
