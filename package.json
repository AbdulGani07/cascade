{
  "name": "@cascade-code/monorepo",
  "private": true,
  "version": "3.3.1",
  "description": "Cascade — Dependency intelligence and change-impact analysis platform",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix packages/dashboard",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:docs": "node scripts/validate-docs.mjs",
    "lint": "eslint packages/*/src/**/*.ts --no-error-on-unmatched-pattern",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "benchmark": "node benchmarks/run.mjs",
    "benchmark:performance": "node --expose-gc benchmarks/performance.mjs",
    "benchmark:regression": "node benchmarks/regression.mjs",
    "benchmark:real": "node scripts/validate-real-repositories.mjs",
    "demo:setup": "node examples/cascade-commerce/scripts/setup-demo.mjs",
    "demo:reports": "node examples/cascade-commerce/scripts/generate-reports.mjs",
    "demo:verify": "node examples/cascade-commerce/scripts/verify-demo.mjs",
    "clean": "npm run clean --workspaces",
    "check": "npm run lint && npm run build && npm run typecheck && npm run test && npm run test:docs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:state": "node scripts/validate-version-state.mjs --state --audit-published",
    "release:validate-version-state": "node scripts/validate-version-state.mjs",
    "vscode:version:prepare": "node scripts/validate-version-state.mjs --prepare-vscode",
    "vscode:release:dry-run": "node scripts/dry-run-vscode-release.mjs",
    "release:validate": "node scripts/validate-version-state.mjs && node scripts/validate-release.mjs",
    "release:pack": "node scripts/validate-version-state.mjs && node scripts/validate-release.mjs --pack"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdulGani07/cascade.git"
  },
  "keywords": [
    "dependency-analysis",
    "change-impact",
    "static-analysis",
    "code-intelligence",
    "ast",
    "architecture-governance"
  ],
  "author": "Cascade Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "@changesets/cli": "^2.29.7"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "dagre": "^0.8.5",
    "lucide-react": "^1.27.0",
    "minimatch": "^10.2.5",
    "tailwindcss": "^4.3.3"
  }
}
