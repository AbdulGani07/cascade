{
  "entryPoints": [
    "apps/storefront/src/main.ts",
    "services/api/src/index.ts",
    "services/fulfillment-worker/src/fulfillment_worker/__init__.py",
    "services/fulfillment-worker/src/fulfillment_worker/main.py",
    "services/notification/cmd/notification/main.go"
  ],
  "ignore": ["**/node_modules/**", "**/dist/**", "**/.git/**", "**/.venv/**", "**/__pycache__/**"],
  "pythonSourceRoots": ["services/fulfillment-worker/src"],
  "gitImpact": {
    "testMappings": {
      "packages/pricing/src/index.ts": ["packages/pricing/src/pricing.test.ts"]
    },
    "criticalPaths": ["packages/contracts/", "packages/pricing/"],
    "architectureRules": [
      {
        "id": "api-domain-must-not-import-web",
        "from": "services/api/src/domain/**",
        "to": "apps/storefront/src/**"
      }
    ]
  },
  "architectureGovernance": {
    "version": "1",
    "rules": [
      {
        "id": "domain-must-not-import-web",
        "from": ["services/api/src/domain/**"],
        "deny": ["apps/storefront/src/**"],
        "severity": "error",
        "message": "API domain code must not depend on storefront implementation details."
      }
    ]
  }
}
