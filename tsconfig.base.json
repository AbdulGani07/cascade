{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "baseUrl": ".",
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "types": ["node"],
    "paths": {
      "@cascade-code/plugin-api": ["packages/plugin-api/src/index.ts"],
      "@cascade-code/config": ["packages/config/src/index.ts"],
      "@cascade-code/reporters": ["packages/reporters/src/index.ts"],
      "@cascade-code/language-javascript": ["packages/language-javascript/src/index.ts"],
      "@cascade-code/language-typescript": ["packages/language-typescript/src/index.ts"],
      "@cascade-code/language-rust": ["packages/language-rust/src/index.ts"],
      "@cascade-code/language-c": ["packages/language-c/src/index.ts"],
      "@cascade-code/language-cpp": ["packages/language-cpp/src/index.ts"],
      "@cascade-code/language-expanded": ["packages/language-expanded/src/index.ts"],
      "@cascade-code/test-utils": ["packages/test-utils/src/index.ts"],
      "@cascade-code/core": ["packages/core/src/index.ts"],
      "@cascade-code/editor-service": ["packages/editor-service/src/index.ts"]
    }
  }
}
