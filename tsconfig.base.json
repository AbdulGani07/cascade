{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "baseUrl": ".",
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "types": ["node"],
    "paths": {
      "@cascade/plugin-api": ["packages/plugin-api/src/index.ts"],
      "@cascade/config": ["packages/config/src/index.ts"],
      "@cascade/reporters": ["packages/reporters/src/index.ts"],
      "@cascade/language-javascript": ["packages/language-javascript/src/index.ts"],
      "@cascade/language-typescript": ["packages/language-typescript/src/index.ts"],
      "@cascade/language-rust": ["packages/language-rust/src/index.ts"],
      "@cascade/language-c": ["packages/language-c/src/index.ts"],
      "@cascade/language-cpp": ["packages/language-cpp/src/index.ts"],
      "@cascade/language-expanded": ["packages/language-expanded/src/index.ts"],
      "@cascade/test-utils": ["packages/test-utils/src/index.ts"],
      "@cascade/core": ["packages/core/src/index.ts"]
    }
  }
}
