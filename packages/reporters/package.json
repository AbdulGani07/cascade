{
  "name": "@cascade-code/reporters",
  "version": "3.3.1-next.0",
  "description": "Standard reporters (JSON, Text/Table, Markdown, SARIF) for Cascade analysis results",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdulGani07/cascade.git",
    "directory": "packages/reporters"
  },
  "dependencies": {
    "@cascade-code/plugin-api": "workspace:^"
  },
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
