{
  "name": "@cascade/config",
  "version": "2.0.0",
  "description": "Configuration schema, loader, and plugin prioritization settings for Cascade",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cascade-code/cascade.git",
    "directory": "packages/config"
  },
  "dependencies": {
    "@cascade/plugin-api": "workspace:*"
  },
  "license": "MIT"
}
