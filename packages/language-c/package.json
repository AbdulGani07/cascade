{
  "name": "@cascade-code/language-c",
  "version": "3.3.1",
  "description": "First-party C language plugin for Cascade",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit",
    "benchmark": "node benchmarks/run.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cascade-code/plugin-api": "workspace:^",
    "tree-sitter": "^0.22.4",
    "tree-sitter-c": "0.24.1"
  },
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdulGani07/cascade.git",
    "directory": "packages/language-c"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
