{
  "name": "@cascade/language-expanded",
  "version": "3.1.1",
  "description": "First-party structured plugins for Cascade language expansion batches B, C, and D",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@cascade/plugin-api": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
