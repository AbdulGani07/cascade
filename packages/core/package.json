{
  "name": "@cascade/core",
  "version": "3.0.0",
  "description": "Core dependency graph analysis engine for Cascade",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cascade-code/cascade.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "@cascade/config": "workspace:*",
    "@cascade/language-javascript": "workspace:*",
    "@cascade/language-typescript": "workspace:*",
    "@cascade/language-python": "workspace:*",
    "@cascade/language-java": "workspace:*",
    "@cascade/language-kotlin": "workspace:*",
    "@cascade/language-csharp": "workspace:*",
    "@cascade/language-go": "workspace:*",
    "@cascade/language-rust": "workspace:*",
    "@cascade/language-c": "workspace:*",
    "@cascade/language-cpp": "workspace:*",
    "@cascade/language-expanded": "workspace:*",
    "@cascade/plugin-api": "workspace:*",
    "@cascade/reporters": "workspace:*",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dependency-graph",
    "static-analysis",
    "ast",
    "circular-dependency",
    "dead-code"
  ],
  "license": "MIT"
}
