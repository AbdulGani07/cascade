{
  "name": "@cascade-code/core",
  "version": "3.3.1",
  "description": "Core dependency graph analysis engine for Cascade",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdulGani07/cascade.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "@cascade-code/config": "workspace:^",
    "@cascade-code/language-javascript": "workspace:^",
    "@cascade-code/language-typescript": "workspace:^",
    "@cascade-code/language-python": "workspace:^",
    "@cascade-code/language-java": "workspace:^",
    "@cascade-code/language-kotlin": "workspace:^",
    "@cascade-code/language-csharp": "workspace:^",
    "@cascade-code/language-go": "workspace:^",
    "@cascade-code/language-rust": "workspace:^",
    "@cascade-code/language-c": "workspace:^",
    "@cascade-code/language-cpp": "workspace:^",
    "@cascade-code/language-expanded": "workspace:^",
    "@cascade-code/plugin-api": "workspace:^",
    "@cascade-code/reporters": "workspace:^",
    "minimatch": "^10.2.6",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "dependency-graph",
    "static-analysis",
    "ast",
    "circular-dependency",
    "dead-code"
  ],
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
