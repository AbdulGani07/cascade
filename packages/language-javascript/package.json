{
  "name": "@cascade/language-javascript",
  "version": "3.1.0",
  "description": "First-party JavaScript language plugin for Cascade platform",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cascade-code/cascade.git",
    "directory": "packages/language-javascript"
  },
  "dependencies": {
    "@cascade/plugin-api": "workspace:*",
    "typescript": "^5.9.3",
    "tree-sitter": "^0.22.4",
    "tree-sitter-javascript": "^0.23.1"
  },
  "license": "MIT"
}
