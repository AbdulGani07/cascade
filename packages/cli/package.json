{
  "name": "@cascade-code/cli",
  "version": "3.3.0",
  "description": "Command-line interface for Cascade code-intelligence analysis",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "cascade": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist/dashboard"
  ],
  "scripts": {
    "build": "pnpm --dir ../dashboard run build && tsc -b tsconfig.json --force && node ../../scripts/prepare-cli-assets.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdulGani07/cascade.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "cli",
    "code-analysis",
    "dependency-graph",
    "impact-analysis"
  ],
  "license": "MIT",
  "dependencies": {
    "@cascade-code/config": "workspace:^",
    "@cascade-code/core": "workspace:^",
    "@cascade-code/plugin-api": "workspace:^",
    "@cascade-code/reporters": "workspace:^",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "sirv": "^3.0.2"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
