{
  "name": "@cascade/plugin-api",
  "version": "3.2.0",
  "description": "Stable plugin contracts and type definitions for Cascade language plugins",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cascade-code/cascade.git",
    "directory": "packages/plugin-api"
  },
  "keywords": [
    "cascade",
    "plugin-api",
    "language-plugin",
    "static-analysis"
  ],
  "license": "MIT"
}
