{
  "name": "@cascade/editor-service",
  "version": "3.3.0",
  "description": "Local editor integration service for Cascade code intelligence",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "cascade-editor-service": "./dist/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AbdulGani07/cascade.git",
    "directory": "packages/editor-service"
  },
  "keywords": [
    "language-server",
    "editor",
    "dependency-analysis",
    "code-intelligence"
  ],
  "license": "MIT",
  "dependencies": {
    "@cascade/config": "workspace:*",
    "@cascade/core": "workspace:*",
    "@cascade/plugin-api": "workspace:*"
  }
}
